<Project>
  <PropertyGroup>
    <!-- Suppress NU1507 (multiple package sources with CPM) -->
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>

  <!--
    Build-only packages. PrivateAssets must live here, on the PackageReference.
    NuGet reads only Version from a PackageVersion item in Directory.Packages.props,
    so PrivateAssets written there is silently ignored and the package is emitted
    into every dependency group of the nupkg.
  -->
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- SourceLink / build hygiene -->
  <PropertyGroup>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!--
    Package metadata. This group is deliberately unconditional: a csproj sets
    IsPackable in its own body, which MSBuild evaluates after this file, so a
    Condition on IsPackable here is always false and the metadata never applied.
    The properties do nothing in a project that does not pack, and a csproj that
    sets one of them still wins.
  -->
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/Stillpoint-Software/Hyperbee.Resources/releases/latest</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/Stillpoint-Software/Hyperbee.Resources</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Stillpoint-Software/Hyperbee.Resources</PackageProjectUrl>
  </PropertyGroup>

  <!--
    README, LICENSE and the icon are packed by the library csproj. They were packed
    here as well, which produced three NU5118 warnings per pack because the same
    package paths were contributed twice.
  -->

  <!-- Global project properties - .NET 10 LTS First Strategy -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Primary target: .NET 10 (LTS), with .NET 11 (STS) for current support.
      net8.0 and net9.0 are gone: both reached end of support on 2026-11-10.
      netstandard2.1 is the compatibility floor, so a net8.0 or net9.0 consumer
      still resolves an asset and this stays a non-breaking change.
    -->
    <TargetFrameworks>net11.0;net10.0;netstandard2.1</TargetFrameworks>
  </PropertyGroup>

  <!--
    The SDK defaults netstandard2.1 to C# 8, which predates init accessors and
    collection expressions, both of which this library's sources use. net10.0 and
    net11.0 already default to the SDK's latest, so this only affects netstandard.
  -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('netstandard'))">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    PolySharp generates the two compiler-required types netstandard2.1 lacks,
    IsExternalInit and CallerArgumentExpressionAttribute, as internal types in each
    assembly that references it. On net10.0 and net11.0, where the framework has
    them, it emits [TypeForwardedTo] instead. That forwarder is what keeps init
    accessors binding when code compiled against the netstandard2.1 asset runs on a
    net10.0+ asset; without it the call throws MissingMethodException.

    Only these two types are generated. Everything else PolySharp can polyfill is
    left off so no unused internal types land in the assemblies.
  -->
  <PropertyGroup>
    <PolySharpIncludeGeneratedTypes>System.Runtime.CompilerServices.IsExternalInit;System.Runtime.CompilerServices.CallerArgumentExpressionAttribute</PolySharpIncludeGeneratedTypes>
  </PropertyGroup>
</Project>
