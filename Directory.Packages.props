<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Development Tools. PrivateAssets belongs on the PackageReference in
      Directory.Build.props, not here: NuGet reads only Version from a
      PackageVersion item, so metadata written here does nothing.
    -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
    <!-- Testing Framework -->
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
  </ItemGroup>
</Project>
